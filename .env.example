# Copy this file to .env (apps/web reads it via Next's built-in .env
# loading), fill in real values, and run `pnpm doctor` to check it.
# NEVER commit the real .env file — see .gitignore.

# --- Database (Neon Postgres) ---
# Ordinary application requests use this. It MUST be a restricted role —
# see docs/security.md ("a separate, more restricted database role for
# ordinary requests than for migrations").
DATABASE_URL=postgres://app_role:password@host/dbname?sslmode=require

# Used only by `pnpm db:migrate` and `drizzle-kit generate` — a more
# privileged role than DATABASE_URL. Never imported by request-handling
# code (see packages/database/src/client.ts).
DATABASE_MIGRATION_URL=postgres://migration_role:password@host/dbname?sslmode=require

# --- Auth0 (web) ---
# Required by the @auth0/nextjs-auth0 SDK (apps/web/src/server/auth/auth0Client.ts).
AUTH0_SECRET=              # generate with: openssl rand -hex 32
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000

# The API identifier (audience) configured in Auth0 — required so both
# the web app's bearer-token verification path (mobile calls) and the
# mobile app itself request access tokens for the right API.
AUTH0_AUDIENCE=https://api.uptetprep.com

# --- Auth0 (mobile) ---
# EXPO_PUBLIC_* vars are bundled into the client — never put a secret
# here (see docs/security.md). PKCE is exactly the flow designed for this:
# no client secret is needed for the mobile app.
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.uptetprep.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
